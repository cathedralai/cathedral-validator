# Root-owned public configuration, mode 0600. It contains no wallet key.
CATHEDRAL_SNP_POLICY=/etc/cathedral-validator/snp-policy.json
CATHEDRAL_VALIDATOR_INTERVAL_SECONDS=1500

# Escape room contest receipts (off by default). Both lines are needed to turn
# it on: a receipt source (https URL or absolute path to a JSON list) and a
# fraction in [0, 1/2] of each vector that verified breakers share. Intended
# mainnet share is 0.05. Receipts are verified against the vendored contest
# key only and count for the reward window after their contest window was
# planted. Unset either line, or set the fraction to 0, to roll back.
# See docs/ESCAPE-PAYOUT-ROLLOUT.md. Do not enable on mainnet until the
# testnet 584 staged break has been confirmed.
#CATHEDRAL_ESCAPE_RECEIPTS_SOURCE=/etc/cathedral-validator/escape-receipts.json
#CATHEDRAL_ESCAPE_WEIGHT_FRACTION=0.05
#CATHEDRAL_ESCAPE_REWARD_WINDOW_SECONDS=604800
