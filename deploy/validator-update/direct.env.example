# Root-owned public configuration, mode 0600. It contains no wallet key.
CATHEDRAL_VALIDATOR_QVL=/opt/cathedral-verifier/cathedral-tdx-verifier
CATHEDRAL_SNP_POLICY=/etc/cathedral-validator/snp-policy.json
CATHEDRAL_SNPGUEST=/usr/local/lib/cathedral-validator/snpguest
CATHEDRAL_VALIDATOR_INTERVAL_SECONDS=1500
