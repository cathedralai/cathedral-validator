# Root-owned public configuration, mode 0600. It contains no wallet key.
CATHEDRAL_SNP_POLICY=/etc/cathedral-validator/snp-policy.json
CATHEDRAL_VALIDATOR_INTERVAL_SECONDS=1500

# Escape room contest receipts: ON by default. With these lines commented out
# the validator reads the public feed below with the switch fraction 1/10.
# The fraction is only the switch: verified breakers share a fixed 10 percent
# of each vector, and while the lane is off or has no break that 10 percent is
# burned (docs/GATED_COMPUTE.md). Receipts are verified against the vendored
# contest signer set and count for the reward window after their contest
# window was planted. A line you set wins over the default. To opt out, set
# the fraction to 0 (or the source to off). See docs/ESCAPE-PAYOUT-ROLLOUT.md.
#CATHEDRAL_ESCAPE_RECEIPTS_SOURCE=https://api.polaris.computer/v1/escape/receipts/published
#CATHEDRAL_ESCAPE_REWARD_WINDOW_SECONDS=604800
# Opt out of the escape lane (uncomment only to turn it off):
#CATHEDRAL_ESCAPE_WEIGHT_FRACTION=0
