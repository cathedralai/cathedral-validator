# Root-owned, mode 0600. A validator only follows one timer.
# UID30 uses the canary timer. Other validators use the stable timer.
CATHEDRAL_VALIDATOR_CANARY_METADATA_URL=https://raw.githubusercontent.com/cathedralai/cathedral-validator/validator-release-channel/validator/canary.json
CATHEDRAL_VALIDATOR_STABLE_METADATA_URL=https://raw.githubusercontent.com/cathedralai/cathedral-validator/validator-release-channel/validator/stable.json
# Trusted bootstrap checkpoints. The signed bootstrap builder replaces the
# stable placeholders from a verified signed stable record. A fresh validator
# refuses every older signed sequence. Its first install treats the stable
# record whose digest is bound here as the committed anchor: a different record
# at that sequence is refused, and later signed releases proceed by the
# monotonic signed release contract.
CATHEDRAL_VALIDATOR_CANARY_MINIMUM_SEQUENCE=1
CATHEDRAL_VALIDATOR_STABLE_MINIMUM_SEQUENCE=REPLACE_WITH_AUTHENTICATED_STABLE_SEQUENCE
CATHEDRAL_VALIDATOR_STABLE_METADATA_SHA256=REPLACE_WITH_AUTHENTICATED_STABLE_METADATA_SHA256
