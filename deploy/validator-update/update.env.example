# Root-owned, mode 0600. A validator only follows one timer.
# UID30 uses the canary timer. Other validators use the stable timer.
CATHEDRAL_VALIDATOR_CANARY_METADATA_URL=https://releases.cathedral.com/validator/canary.json
CATHEDRAL_VALIDATOR_STABLE_METADATA_URL=https://releases.cathedral.com/validator/stable.json
# Trusted bootstrap checkpoints. Set these from an authenticated release record
# during installation. A fresh validator refuses every older signed sequence.
CATHEDRAL_VALIDATOR_CANARY_MINIMUM_SEQUENCE=1
CATHEDRAL_VALIDATOR_STABLE_MINIMUM_SEQUENCE=1
# This is the canonical direct-writer state.json for this validator hotkey.
# The explicit first-install bootstrap creates its idle journal and cycle lock.
CATHEDRAL_VALIDATOR_DIRECT_JOURNAL=/var/lib/cathedral-validator/.local/state/cathedral-validator/direct-writer/finney-sn39-mechanism-0/YOUR_HOTKEY/state.json
