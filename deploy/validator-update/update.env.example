# Root-owned, mode 0600. A validator only follows one timer.
# UID30 uses the canary timer. Other validators use the stable timer.
CATHEDRAL_VALIDATOR_CANARY_METADATA_URL=https://raw.githubusercontent.com/cathedralai/cathedral-validator/validator-release-channel/validator/canary.json
CATHEDRAL_VALIDATOR_STABLE_METADATA_URL=https://raw.githubusercontent.com/cathedralai/cathedral-validator/validator-release-channel/validator/stable.json
# Trusted bootstrap checkpoints. Set these from an authenticated release record
# during installation. A fresh validator refuses every older signed sequence.
CATHEDRAL_VALIDATOR_CANARY_MINIMUM_SEQUENCE=1
CATHEDRAL_VALIDATOR_STABLE_MINIMUM_SEQUENCE=1
