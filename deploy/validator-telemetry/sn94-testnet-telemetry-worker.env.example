# Testnet 584 → Cathedral Worker collector (signed ingest).
# Distinct dummy files are required by the exporter binary; the Worker ignores
# their contents. Do not reuse Sites SIWC secrets for this path.
CATHEDRAL_TELEMETRY_ENDPOINT=https://cathedral.computer/v1/leaderboard/ingest
CATHEDRAL_TELEMETRY_TOKEN_FILE=/etc/sn94-testnet-telemetry/worker-ingest.dummy
CATHEDRAL_TELEMETRY_SITES_AUTH_FILE=/etc/sn94-testnet-telemetry/worker-sites.dummy
