#!/bin/bash
# One epoch of the standing reference-miner loop, asserted and journalled.
#
# Asks the scoring oracle what the reference miner earned this epoch, decides
# GREEN or RED, and appends exactly one EPOCH_STATUS record to the journal that
# cathedral-catminer-alert-check reads. Writes one record per invocation and
# never rewrites an existing one: the journal is append-only.
#
# GREEN requires ALL of:
#   * the oracle answered, and its answer parsed;
#   * credited score > 0 (an `earned == 0` epoch is the failure this gate is
#     built to catch, per issue #108);
#   * every gate in CATMINER_EXPECTED_GATES reported its expected verdict;
#   * the representative attestation receipt verified.
#
# Anything else is RED, including "the oracle could not be reached". A canary
# that reports green when it cannot see the thing it watches is worse than no
# canary: that is the failure deploy/sn39/cathedral-mismatch-check's rules 1-3
# were added for, after rules 4-5 stayed green for a validator that no longer
# existed. The same principle is load-bearing here, so it is enforced in the
# producer as well as the consumer.
#
# The oracle is a command, not an HTTP call baked in here, because the score
# lives in the validator's own composition path. CATMINER_ORACLE_CMD must print
# ONE JSON object on stdout:
#
#   {"epoch": 41, "earned": 3.5, "receipt_verified": true,
#    "gates": {"attestation": "ok", "verified": "true", "contributing": "true"},
#    "lane": {"cybergym": 0.30, "compute": 0.70, "burned": 0.0}}
#
# The reference implementation (see README.md) calls
# `mechanism_cybergym_adapter.cybergym_score_snapshot` on the validator host and
# reshapes its `(vec, meta, info)` into that object. It consumes the real
# validator rather than reimplementing scoring, which is issue #108's stated
# non-goal.
set -u
export LC_ALL=C

JOURNAL="${CATMINER_JOURNAL:-/var/log/cathedral-catminer/catminer-events.jsonl}"
MAX_LINES="${CATMINER_JOURNAL_MAX_LINES:-20000}"
ORACLE="${CATMINER_ORACLE_CMD:-}"
MINER="${CATMINER_MINER_HOTKEY:-}"
EXPECTED_GATES="${CATMINER_EXPECTED_GATES:-attestation=ok,verified=true,contributing=true}"

now() { date -u "+%Y-%m-%dT%H:%M:%S.000Z"; }

# JSON string escape for values that reach the journal (oracle stderr, reasons).
esc() { printf '%s' "${1-}" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$(printf '\t')/ /g" | tr -d '\000-\037'; }

# Append one record, then bound the file. Bounded like the validator's journal:
# newest MAX_LINES retained, one rotated generation kept beside it so the alert
# can still see recent history across a truncation (the alert reads .1 too).
emit() {
  local record="$1"
  local dir; dir=$(dirname -- "$JOURNAL")
  mkdir -p -- "$dir" 2>/dev/null
  if ! printf '%s\n' "$record" >> "$JOURNAL"; then
    echo "catminer-assert: cannot append to journal '$JOURNAL'" >&2
    return 1
  fi
  local lines; lines=$(wc -l < "$JOURNAL" 2>/dev/null || echo 0)
  if [ "$lines" -gt "$MAX_LINES" ]; then
    # copytruncate-style: keep one generation, then truncate in place so any
    # writer holding the descriptor open keeps writing to the same inode.
    cp -- "$JOURNAL" "$JOURNAL.1" 2>/dev/null &&
      tail -n "$MAX_LINES" -- "$JOURNAL.1" > "$JOURNAL" 2>/dev/null
  fi
  return 0
}

red() {
  local reason="$1" epoch="${2:-null}" detail="${3:-}"
  emit "{\"ts\":\"$(now)\",\"event\":\"EPOCH_STATUS\",\"verdict\":\"RED\",\"epoch\":${epoch},\"miner\":\"$(esc "$MINER")\",\"reason\":\"$(esc "$reason")\",\"detail\":\"$(esc "$detail")\"}"
  echo "RED: $reason${detail:+ — $detail}" >&2
  exit 1
}

[ -n "$ORACLE" ] || red "oracle_not_configured" null "CATMINER_ORACLE_CMD is unset; this loop cannot see a score and must not report green"
[ -n "$MINER" ] || red "miner_not_configured" null "CATMINER_MINER_HOTKEY is unset"

emit "{\"ts\":\"$(now)\",\"event\":\"EPOCH_BEGIN\",\"miner\":\"$(esc "$MINER")\"}"

# Private temp file, not a fixed /tmp path: a fixed one is owned by whichever
# user ran first, so the next user's run dies on "Permission denied" and the
# oracle looks broken when it never ran. mktemp failing is itself fail-closed.
ERRFILE=$(mktemp "${TMPDIR:-/tmp}/catminer-oracle.XXXXXX") ||
  red "oracle_setup_failed" null "could not create a temporary file to capture oracle stderr"
trap 'rm -f -- "$ERRFILE"' EXIT

OUT=$(eval "$ORACLE" 2>"$ERRFILE")
RC=$?
ERR=$(tail -c 400 -- "$ERRFILE" 2>/dev/null)
[ "$RC" -eq 0 ] || red "oracle_failed" null "exit $RC: $ERR"
[ -n "$OUT" ] || red "oracle_empty" null "the oracle exited 0 but printed nothing"

# Parse with python3 so a malformed or partial answer is a hard failure rather
# than a grep that silently matches nothing and reads as zero.
PARSED=$(printf '%s' "$OUT" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception as exc:
    print("PARSE_ERROR", str(exc)[:200]); raise SystemExit(0)
if not isinstance(d, dict):
    print("PARSE_ERROR", "oracle did not return a JSON object"); raise SystemExit(0)
try:
    earned = float(d["earned"])
except Exception:
    print("PARSE_ERROR", "earned is missing or not a number"); raise SystemExit(0)
epoch = d.get("epoch")
epoch = int(epoch) if isinstance(epoch, (int, float)) and not isinstance(epoch, bool) else None
gates = d.get("gates") or {}
if not isinstance(gates, dict):
    print("PARSE_ERROR", "gates is not an object"); raise SystemExit(0)
print("OK")
print(epoch if epoch is not None else "null")
print(repr(earned))
print("true" if d.get("receipt_verified") is True else "false")
print(json.dumps({str(k): str(v) for k, v in gates.items()}, sort_keys=True))
print(json.dumps(d.get("lane") if isinstance(d.get("lane"), dict) else {}, sort_keys=True))
' 2>/dev/null)

case "$PARSED" in
  PARSE_ERROR*) red "oracle_unparseable" null "${PARSED#PARSE_ERROR }" ;;
  OK*) ;;
  *) red "oracle_unparseable" null "the parser itself failed; oracle output was not usable JSON" ;;
esac

EPOCH=$(printf '%s\n' "$PARSED" | sed -n 2p)
EARNED=$(printf '%s\n' "$PARSED" | sed -n 3p)
RECEIPT=$(printf '%s\n' "$PARSED" | sed -n 4p)
GATES=$(printf '%s\n' "$PARSED" | sed -n 5p)
LANE=$(printf '%s\n' "$PARSED" | sed -n 6p)

# earned > 0. Compared in awk so "0.0", "0e0" and "-1" all decide correctly.
if ! awk -v e="$EARNED" 'BEGIN { exit !(e > 0) }'; then
  red "earned_zero" "$EPOCH" "credited score was $EARNED; an epoch that earns nothing is the regression this canary exists to catch"
fi

# Every expected gate must be present AND equal to its expected verdict. A gate
# the oracle stopped reporting is a failure, not a pass: silent removal is
# exactly how a gate stops protecting anything.
MISMATCH=$(printf '%s' "$GATES" | CATMINER_EXPECTED_GATES="$EXPECTED_GATES" python3 -c '
import json, os, sys
gates = json.load(sys.stdin)
bad = []
for pair in os.environ.get("CATMINER_EXPECTED_GATES", "").split(","):
    pair = pair.strip()
    if not pair:
        continue
    name, _, want = pair.partition("=")
    name, want = name.strip(), want.strip()
    got = gates.get(name)
    if got is None:
        bad.append(f"{name} absent (expected {want})")
    elif got.lower() != want.lower():
        bad.append(f"{name}={got} (expected {want})")
print("; ".join(bad))
')
# A comparison that could not run is not a passing comparison. Without this the
# gate check fails OPEN: python exits non-zero, MISMATCH is empty, and the empty
# string reads as "every gate agreed".
GATE_RC=$?
[ "$GATE_RC" -eq 0 ] || red "gate_check_failed" "$EPOCH" "the gate comparison could not run (exit $GATE_RC); refusing to treat that as agreement"
[ -z "$MISMATCH" ] || red "gate_verdict" "$EPOCH" "$MISMATCH"

[ "$RECEIPT" = "true" ] || red "receipt_unverified" "$EPOCH" "the representative attestation receipt did not verify"

emit "{\"ts\":\"$(now)\",\"event\":\"EPOCH_STATUS\",\"verdict\":\"GREEN\",\"epoch\":${EPOCH},\"miner\":\"$(esc "$MINER")\",\"earned\":${EARNED},\"receipt_verified\":true,\"gates\":${GATES},\"lane\":${LANE}}"
echo "GREEN: epoch $EPOCH earned $EARNED, gates $GATES, receipt verified, lane $LANE"
