[Unit]
# Self-composing publisher role 2/3: the thin publisher. Serves the SIGNED
# weight vector that the consolidated attestation-verified validator fetches
# from its LOCAL [publisher] url (config/validator-selfcompose-sn39.toml points
# at 127.0.0.1:8010). VALIDATOR-sourced code, same scaffold.publisher.server:app
# module the hub image served.
Description=Cathedral SN39 thin publisher (self-composing publisher role)
After=network-online.target
Wants=network-online.target
Conflicts=cathedral-scorer-sn39.service cathedral-weight-feed-publish.service

[Service]
Type=simple
User=cathedral-publisher
Group=cathedral-publisher
# Per-role environment; commit NO secrets. Signing key + any DATABASE_URL /
# bucket credentials are provisioned out of band (see the .env.example).
EnvironmentFile=/etc/cathedral-publisher/cathedral-publisher.env
Environment=NETUID=39
Environment=CATHEDRAL_WEIGHT_POLICY_NETWORK=finney
Environment=PORT=8010
ExecStartPre=/bin/sh -c '! systemctl is-active --quiet cathedral-scorer-sn39.service cathedral-weight-feed-publish.service'
ExecStart=/opt/cathedral-publisher/venv/bin/uvicorn scaffold.publisher.server:app \
    --host 127.0.0.1 --port ${PORT} \
    --workers ${WEB_CONCURRENCY:-2} --no-access-log
Restart=on-failure
RestartSec=15s
TimeoutStopSec=30s
StateDirectory=cathedral-publisher
StateDirectoryMode=0700
LogsDirectory=cathedral-publisher
LogsDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/cathedral-publisher /var/log/cathedral-publisher

[Install]
WantedBy=multi-user.target
