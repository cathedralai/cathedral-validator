# Example EnvironmentFile for cathedral-scorer-sn39.service.
# Install as /etc/cathedral-publisher/cathedral-scorer-sn39.env, mode 0600,
# owned by cathedral-publisher. COMMIT NO SECRETS — the values below marked
# <...> are placeholders provisioned out of band.

# --- one production posture (REQUIRED) --------------------------------------
# The systemd unit sets CATHEDRAL_ENV=production. Production refuses to start
# without this named profile. Do not replace it with loose CATHEDRAL_V2_* flags.
CATHEDRAL_LAUNCH_PROFILE=v2-converged
CATHEDRAL_SERVICE_ROLE=all
CATHEDRAL_PUBLISHER_GENERATION_ID=sn39-v2-converged-20260829-01
# CyberGym remains outside this production publisher posture.
CATHEDRAL_CYBERGYM_INGEST_ENABLED=false

# --- signing (REQUIRED) -----------------------------------------------------
# Ed25519 weight-policy signing key. Same key the pinned public_key_hex in the
# validator configs verifies against. Provisioned out of band.
CATHEDRAL_EVAL_SIGNING_KEY=<ed25519-signing-key>

# Stable protocol secrets shared by every process serving this origin.
CATHEDRAL_V2_SUBMIT_TOKEN_SECRET=<v2-submit-token-secret>
CATHEDRAL_V2_PERMINER_SEED_SECRET=<v2-per-miner-seed-secret>

# Dedicated credentials for the canonical confidential-TDX score producer.
CATHEDRAL_EXTERNAL_SCORES_TOKEN_CATHEDRAL_CONFIDENTIAL_TDX=<confidential-tdx-token>
CATHEDRAL_EXTERNAL_SCORES_HMAC_SECRET_CATHEDRAL_CONFIDENTIAL_TDX=<confidential-tdx-hmac-secret>

# --- weight policy identity -------------------------------------------------
CATHEDRAL_WEIGHT_POLICY_KEY_ID=cathedral-weight-policy
CATHEDRAL_WEIGHT_POLICY_NETUID=39
CATHEDRAL_WEIGHT_POLICY_NETWORK=finney
# NETWORK and NETUID are also set in the systemd unit. Keeping them here makes
# this shared environment file complete for the packaged container too.

# --- storage ----------------------------------------------------------------
# The production profile requires one shared Postgres store.
DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<db>
CATHEDRAL_PG_STATEMENT_TIMEOUT_MS=4000

# --- canonical recurring publisher and relay contract -----------------------
# The canonical relay requires validated_supply_v1. These values make the
# producer emit its existing v2 contract: 90% validated TDX and 10% fixed burn.
# Changing one requires a separately named, reviewed launch profile.
CATHEDRAL_ALLOCATION_CONTRACT=v2
CATHEDRAL_VALIDATED_SUPPLY_ENABLED=true
CATHEDRAL_WEIGHTS_MODE=proportional
CATHEDRAL_PERMINER_SCORING_MODE=bonus
CATHEDRAL_PERMINER_BONUS_MULT=0.2
CATHEDRAL_PERMINER_HISTORY_FLOOR=0.25
CATHEDRAL_PERMINER_REQUIRE_COLDKEY=true
CATHEDRAL_WEIGHTS_WINDOW_HOURS=24
CATHEDRAL_WEIGHTS_TIER2_MULT=3
# Empty selects the pinned tier-1=1, tier-2=3 default map.
CATHEDRAL_WEIGHTS_TIER_WEIGHTS=
CATHEDRAL_WEIGHTS_PAYABLE_HOTKEYS=off
CATHEDRAL_WEIGHTS_PAYABLE_HOTKEYS_MAX_AGE_SECS=600
CATHEDRAL_WEIGHTS_COLDKEY_COLLAPSE=false
CATHEDRAL_V2_CHALLENGE_SOURCE=planted
CATHEDRAL_V2_REAL_FRACTION=0
CATHEDRAL_V2_REQUIRE_SOLVER_META=false
# Empty means every hotkey with a valid signature may mint its own submit token.
# Current registration is enforced later when confidential scores are composed.
CATHEDRAL_V2_SUBMIT_TOKEN_ALLOWLIST=
CATHEDRAL_V2_SUBMIT_TOKEN_TTL_SECS=300
CATHEDRAL_V2_SUBMIT_BITSET_MAX_BODY_BYTES=16384
# The bitset lane is configured for 24 concurrent requests, then clamped by
# the reviewed process hard cap to an effective maximum of 8. Saturated
# requests wait at most 0.35 seconds for a slot before receiving a retryable 429.
CATHEDRAL_SUBMIT_MAX_CONCURRENCY=24
CATHEDRAL_SUBMIT_HARD_CAP=8
CATHEDRAL_SUBMIT_BUSY_WAIT_SECS=0.35
# Manifest/blob, alternate CNF distribution, and external result publishing are
# development/history paths. Production exposes the scored bitset path only.
CATHEDRAL_V2_BLOB_UPLOAD_ENABLED=false
CATHEDRAL_V2_CNF_ARTIFACTS_ENABLED=false
CATHEDRAL_V2_RESULTS_PUBLISH_ENABLED=false
CATHEDRAL_V2_VERIFY_WORKER_ENABLED=true
CATHEDRAL_EXTERNAL_SCORES_ENABLED=true
CATHEDRAL_EXTERNAL_SCORES_INGEST_ENABLED=true
CATHEDRAL_EXTERNAL_SCORES_MODE=confidential_primary
CATHEDRAL_EXTERNAL_SCORES_SOURCE=cathedral_confidential_tdx
CATHEDRAL_EXTERNAL_SCORES_PRIMARY_CONFIRM=true
CATHEDRAL_EXTERNAL_SCORES_REQUIRE_REGISTERED=true
CATHEDRAL_EXTERNAL_SCORES_REQUIRE_EVIDENCE=false
CATHEDRAL_EXTERNAL_SCORES_WINDOW_SECS=3600
CATHEDRAL_EXTERNAL_SCORES_MAX_REPORT_AGE_SECS=3600
CATHEDRAL_EXTERNAL_SCORES_MAX_REPORT_FUTURE_SECS=120
CATHEDRAL_EXTERNAL_SCORES_MAX_SCORES=4096
CATHEDRAL_EXTERNAL_SCORES_MAX_BODY_BYTES=1048576
CATHEDRAL_WEIGHTS_ORIGIN_FAILCLOSED=true
CATHEDRAL_WEIGHT_POLICY_BURN_HOTKEY=5GP7c3fFazW9GXK8Up3qgu2DJBk8inu4aK9TZy3RuoSWVCMi
# Resolve the burn UID from the hotkey on every finalized metagraph read.
CATHEDRAL_WEIGHT_POLICY_BURN_UID=
CATHEDRAL_WEIGHT_POLICY_FORCED_BURN_PERCENTAGE_V2=10
CATHEDRAL_WEIGHT_POLICY_VALID_FOR_SECS=1800

# --- fixed production admission and disabled unrelated modes ----------------
CATHEDRAL_CLIENT_IP_MODE=headers
CATHEDRAL_TRUSTED_PROXY_HOPS=1
CATHEDRAL_RATELIMIT_RPM=120
CATHEDRAL_MATERIALIZED_SNAPSHOT_ENABLED=false
CATHEDRAL_DASHBOARD_SNAPSHOT_ENABLED=false
CATHEDRAL_TEE_GPU_ENABLED=false
CATHEDRAL_RETENTION_ENABLED=false
CATHEDRAL_ABUSE_LIMIT_ENABLED=false
CATHEDRAL_PER_HOTKEY_LIMIT_ENABLED=false
CATHEDRAL_V2_SUBMIT_BACKPRESSURE_ENABLED=false

# The service fixes the origin to one worker. Do not add WEB_CONCURRENCY.
