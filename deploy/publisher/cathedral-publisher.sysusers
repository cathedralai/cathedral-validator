# Installed as /etc/sysusers.d/cathedral-publisher.conf.
#
# The self-composing publisher role runs under its own system account, distinct
# from cathedral-validator (deploy/sn39/cathedral-sn39-validator.sysusers). The
# publisher serves signed vectors; the validator fetches + broadcasts them. They
# are separate trust domains on a consolidated host, so they get separate
# accounts and separate StateDirectory/LogsDirectory trees.
#
# nologin shell, owns /var/lib/cathedral-publisher. systemd-sysusers never
# deletes accounts, so this filename is publisher-specific to avoid clobbering
# any generic cathedral-*.conf the evidence producer installs.
g cathedral-publisher -
u cathedral-publisher - "Cathedral SN39 self-composing publisher" /var/lib/cathedral-publisher /usr/sbin/nologin
