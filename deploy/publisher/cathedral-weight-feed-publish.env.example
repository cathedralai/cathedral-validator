# Example EnvironmentFile for cathedral-weight-feed-publish.service.
# Install as /etc/cathedral-publisher/cathedral-weight-feed-publish.env,
# mode 0600, owned by cathedral-publisher. COMMIT NO SECRETS.

# --- signing (REQUIRED) -----------------------------------------------------
CATHEDRAL_EVAL_SIGNING_KEY=<ed25519-signing-key>

# --- weight policy identity -------------------------------------------------
CATHEDRAL_WEIGHT_POLICY_KEY_ID=cathedral-weight-policy
CATHEDRAL_WEIGHT_POLICY_NETUID=39

# --- storage ----------------------------------------------------------------
CATHEDRAL_DB_PATH=/var/lib/cathedral-publisher/publisher.db
# DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<db>

# --- allocation contract (v2 default) ---------------------------------------
# CATHEDRAL_ALLOCATION_CONTRACT=v3

# --- serving ----------------------------------------------------------------
WEB_CONCURRENCY=2
