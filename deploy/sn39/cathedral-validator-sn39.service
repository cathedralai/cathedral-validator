[Unit]
Description=Cathedral SN39 validated Intel TDX CPU validator
After=network-online.target cathedral-thin-validator.service cathedral-confidential-validator-sn39.service cathedral-confidential-validator.service cathedral-validator.service
Wants=network-online.target
Conflicts=cathedral-thin-validator.service cathedral-validator-sn39-launch.service cathedral-confidential-validator-sn39.service cathedral-confidential-validator.service cathedral-validator.service
ConditionPathIsReadWrite=/var/lib/cathedral-validator
ConditionPathExists=/etc/cathedral-validator/sn39-recurring-write-authorization.json
ConditionPathExists=/etc/cathedral-validator/sn39-recurring-write-authorization.json.sig
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=cathedral-validator
# Primary group is cathedral-validator-log, NOT cathedral-validator, and the
# difference from the launch and reconcile units is deliberate. LogsDirectory=
# below creates /var/log/cathedral-validator 0750 owned by this process's
# primary group, and cathedral-sn39-public-status.service reads
# validator-status.jsonl, the SANITIZED projection, out of it using
# SupplementaryGroups=cathedral-validator-log. It does NOT read
# validator-events.jsonl: the raw journal carries hotkeys, receipts and arbitrary
# caller-supplied fields and stays 0600 with no reader group.
# Setting this to cathedral-validator to match the one-shots would leave the
# status publisher unable to traverse the directory holding the stream it
# exists to publish. The one-shots
# write their own LogsDirectory that nothing else reads, so they have no reason
# to widen their primary group.
Group=cathedral-validator-log
SupplementaryGroups=cathedral-validator-evidence
Environment=HOME=/var/lib/cathedral-validator
# The reader group is granted to the SANITIZED status projection only.
# CATHEDRAL_VALIDATOR_JSONL_GROUP is deliberately NOT set, so the raw
# journal stays 0600 and the validator refuses to open it any other way.
Environment=CATHEDRAL_VALIDATOR_STATUS_GROUP=cathedral-validator-log
# A service writes to the journal, never a tty, so the renderer would otherwise
# emit monochrome forever. journalctl renders ANSI fine, and NO_COLOR still wins.
Environment=CATHEDRAL_VALIDATOR_FORCE_COLOR=1
# The journal has no terminal to measure, so the layout needs a width to target.
Environment=COLUMNS=100
# Belt and braces. Conflicts= only acts on units systemd is asked to start;
# it cannot stop a writer someone launched by hand. This refuses to start
# at all while any known SN39 writer is active, because the legacy writer
# uses its own state file and runtime root and therefore shares no
# cross-process submission lock with this unit. Two writers on one hotkey
# means nonce races and a second weight extrinsic.
ExecStartPre=/bin/sh -c '! systemctl is-active --quiet cathedral-confidential-validator-sn39.service cathedral-confidential-validator.service cathedral-validator.service'
ExecStart=/usr/bin/python3.12 -I -E -s /usr/local/libexec/cathedral-sn39-release continuous
Restart=on-failure
RestartSec=15s
# #114: contradiction exits 3 ("will not succeed by trying again"). Without
# this, Restart=on-failure restarted the writer 66 times against its own
# stay-stopped remediation. See cathedral-validator-hardening.conf.
RestartPreventExitStatus=3
MemoryMax=2G
MemoryHigh=1500M
TimeoutStopSec=30s
StateDirectory=cathedral-validator
StateDirectoryMode=0700
LogsDirectory=cathedral-validator
LogsDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/cathedral-validator-controlled-sn39/current /opt/cathedral-sn39/bin/cathedral-tdx-verifier
ReadWritePaths=/var/lib/cathedral-validator /var/log/cathedral-validator
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
