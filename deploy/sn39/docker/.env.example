# Cathedral SN39 relay validator — `./cathedral config` writes this for you.
CATHEDRAL_NETWORK=finney            # finney (mainnet) | test
CATHEDRAL_NETUID=39

# Directory on THIS machine holding your coldkeys (…/<wallet>/hotkeys/…), mounted read-only.
HOST_WALLET_PATH=~/.bittensor/wallets
BT_WALLET_NAME=my-coldkey           # your coldkey (wallet) name
CATHEDRAL_VALIDATOR_HOTKEY=validator # your REGISTERED validator hotkey (NOT your miner hotkey)

# Docker is a no-write preview. Production chain writes use the immutable
# systemd launcher documented in the repository root.
