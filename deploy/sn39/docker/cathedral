#!/usr/bin/env bash
# Cathedral SN39 validator — 3 commands, from a cathedral-validator checkout.
#
#   ./cathedral config      set wallet / hotkey / network (writes .env)
#   ./cathedral up          build (first time) + run the validator
#
#   ./cathedral candidate   check which hotkey can validate (reads live chain)
#   ./cathedral logs | status | down
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"; cd "$HERE"
IMAGE="cathedral-sn39-validator:latest"

die() { echo "error: $*" >&2; exit 1; }
need_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is required (Docker Desktop on macOS/Windows, docker.io on Linux)."
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required."
}
expand_tilde() { case "$1" in "~"/*) printf '%s' "${HOME}/${1#\~/}";; "~") printf '%s' "$HOME";; *) printf '%s' "$1";; esac; }
load_env() {
  [ -f .env ] || die "no .env yet — run './cathedral config' first."
  set -a; . ./.env; set +a
  export HOST_WALLET_PATH="$(expand_tilde "${HOST_WALLET_PATH:-$HOME/.bittensor/wallets}")"
}
set_kv() {
  local k="$1" v="$2"; [ -f .env ] || cp .env.example .env
  if grep -qE "^${k}=" .env; then sed -i.bak "s|^${k}=.*|${k}=${v}|" .env && rm -f .env.bak
  else printf '%s=%s\n' "$k" "$v" >> .env; fi
}
ask() { local var="$1" prompt="$2" def="${3:-}" ans; read -r -p "$prompt${def:+ [$def]}: " ans || true; printf '%s' "${ans:-$def}"; }

cmd_build() { need_docker; echo ">> building $IMAGE (pulls bittensor 10.5 + pinned compute — a few minutes)…"; docker compose build; }

cmd_config() {
  local wname hotkey wpath net bcast
  wname="$(ask BT_WALLET_NAME "Coldkey (wallet) name" "${BT_WALLET_NAME:-}")"
  hotkey="$(ask HOTKEY "Registered VALIDATOR hotkey (not your miner)" "${CATHEDRAL_VALIDATOR_HOTKEY:-validator}")"
  wpath="$(ask WPATH "Path to your wallets" "${HOST_WALLET_PATH:-$HOME/.bittensor/wallets}")"
  net="$(ask NET "Network" "${CATHEDRAL_NETWORK:-finney}")"
  echo; echo "Broadcast weights ON-CHAIN? Only 'yes' with a registered + STAKED validator hotkey."
  bcast="$(ask BCAST "Type 'yes' to broadcast, anything else = shadow (safe)" "no")"
  [ -n "$wname" ] || die "a coldkey name is required"
  set_kv BT_WALLET_NAME "$wname"
  set_kv CATHEDRAL_VALIDATOR_HOTKEY "$hotkey"
  set_kv HOST_WALLET_PATH "$wpath"
  set_kv CATHEDRAL_NETWORK "$net"
  set_kv CATHEDRAL_BROADCAST "$([ "$bcast" = yes ] && echo 1 || echo 0)"
  echo ">> wrote .env. Check your hotkey:  ./cathedral candidate    then start:  ./cathedral up"
}

cmd_up() {
  need_docker; load_env
  docker image inspect "$IMAGE" >/dev/null 2>&1 || cmd_build
  local mode; mode="$([ "${CATHEDRAL_BROADCAST:-0}" = 1 ] && echo 'BROADCAST (on-chain)' || echo 'SHADOW (no writes)')"
  echo ">> starting the validator — mode: $mode"
  docker compose up -d
  echo ">> up. Watch it:  ./cathedral logs"
}

cmd_candidate() { need_docker; load_env; docker compose run --rm --no-deps validator candidate; }
cmd_logs()      { load_env; docker compose logs -f --tail=100; }
cmd_status()    { load_env; docker compose ps; }
cmd_down()      { load_env; docker compose down; }

case "${1:-}" in
  install|build) cmd_build ;;
  config)        cmd_config ;;
  up|run)        cmd_up ;;
  candidate)     cmd_candidate ;;
  logs)          cmd_logs ;;
  status)        cmd_status ;;
  down|stop)     cmd_down ;;
  *) cat <<EOF
Cathedral SN39 validator — 3 commands.

  ./cathedral config      set wallet / hotkey / network (writes .env)
  ./cathedral up          build (first time) + run the validator
  ./cathedral candidate   which of your hotkeys can validate (reads live chain)
  ./cathedral logs | status | down
EOF
    ;;
esac
